# Runtime configuration for systemd. Keep mode 0640, owned root:supplyhub.
# Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
DATA_DIR=/var/lib/supply-chain-hub
LOG_LEVEL=info
TRUST_PROXY=1
# nginx owns HSTS at the TLS terminator; leave the app header off here.
ENABLE_HSTS=0
READ_ONLY=false
API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=262144
MAX_QUERY_DEPTH=12
MAX_QUERY_FIELDS=500
