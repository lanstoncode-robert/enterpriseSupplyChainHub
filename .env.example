# ---------------------------------------------------------------------------
# Supply Chain Hub - runtime configuration
# Copy to .env only if your process manager loads dotenv files. The server
# itself has zero dependencies and reads plain environment variables, so on
# Docker/systemd/Render set these in the platform instead.
# ---------------------------------------------------------------------------

# HTTP listener
PORT=8080
HOST=0.0.0.0
# Host-side port used by docker-compose.yml only.
HUB_PORT=8080

# production | staging | development
NODE_ENV=production

# Absolute or relative path for the JSON datastore. Mount a persistent volume.
DATA_DIR=./data

# Verbose request/operation logging: info | warn | error | silent
LOG_LEVEL=info

# Seed the datastore when the file does not exist.
SEED_ON_START=true

# GraphQL complexity guards
MAX_QUERY_DEPTH=12
MAX_QUERY_FIELDS=500

# Optional bearer token protecting every /graphql request and /admin/* route.
# Leave empty for an open demo. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Comma-separated origins allowed to call the API cross-origin. Same-origin
# requests (the bundled UI) are always allowed.
ALLOWED_ORIGINS=

# Reject all mutations and keep the deployment as a read-only showcase.
READ_ONLY=false

# Rate limiting (per client IP, fixed window)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Request body cap in bytes
BODY_LIMIT_BYTES=262144

# Set to 1 only when behind a trusted reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=0

# Enable HSTS. Only turn on when served over HTTPS.
ENABLE_HSTS=0
